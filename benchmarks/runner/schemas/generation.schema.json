{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ceebench/generation/1",
  "title": "Generator output for one case; generation/1 is a legacy import format without binding",
  "type": "object",
  "required": [
    "schema",
    "case_id",
    "variant_id",
    "cee",
    "model",
    "generated_at",
    "publishable",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "enum": [
        "ceebench/generation/1",
        "ceebench/generation/2"
      ]
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "variant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "cee": {
      "type": "object",
      "required": [
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string"
        },
        "spec_commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "name",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "client": {
          "type": "string"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "publishable": {
      "type": "boolean"
    },
    "views": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "type": {
            "enum": [
              "confirmed_defect",
              "conditional_risk",
              "clarification_request",
              "suggestion",
              "design_concern",
              "reply",
              "non_finding",
              null
            ]
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3",
              null
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              null
            ]
          },
          "decision": {
            "enum": [
              "publish",
              "revise",
              "omit",
              "defer"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "dataset_manifest_sha256",
        "case_id",
        "contexts",
        "spec",
        "runner_fingerprint"
      ],
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "dataset_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "case_id": {
          "type": "string"
        },
        "contexts": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "spec": {
          "type": "object",
          "required": [
            "version",
            "commit"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            }
          }
        },
        "runner_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prompt_builder_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "instructions_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "dataset_manifest_sha256",
        "case_id",
        "contexts",
        "spec",
        "runner_fingerprint"
      ],
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "dataset_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "case_id": {
          "type": "string"
        },
        "contexts": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "spec": {
          "type": "object",
          "required": [
            "version",
            "commit"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            }
          }
        },
        "runner_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prompt_builder_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "instructions_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
