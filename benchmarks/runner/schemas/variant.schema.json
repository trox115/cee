{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ceebench/variant/1",
  "title": "Evaluator-only prior or reference variant",
  "type": "object",
  "required": [
    "schema",
    "case_id",
    "variant_id",
    "status",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ceebench/variant/1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "variant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "status": {
      "enum": [
        "original",
        "reported_output"
      ]
    },
    "cee_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "extraction": {
          "type": "string"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
          },
          "reported_words": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  }
}
