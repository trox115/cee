{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ceebench/dataset/1",
  "title": "Benchmark dataset manifest",
  "type": "object",
  "required": [
    "schema",
    "dataset_id",
    "publishable",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ceebench/dataset/1"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "description": {
      "type": "string"
    },
    "publishable": {
      "type": "boolean"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
          }
        }
      }
    }
  }
}
