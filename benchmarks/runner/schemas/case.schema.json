{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ceebench/case/1",
  "title": "Evidence packet (one review discussion); case/1 legacy, case/2 with selection records",
  "type": "object",
  "required": [
    "schema",
    "case_id",
    "publishable",
    "source",
    "items",
    "files",
    "retrieval_log"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "enum": [
        "ceebench/case/1",
        "ceebench/case/2"
      ]
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "publishable": {
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "system",
        "repository",
        "change_id"
      ],
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "change_id": {
          "type": "string"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    },
    "retrieval_log": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/retrieval"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selection_record"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "item_id",
        "role",
        "author_role",
        "posted_at",
        "reviewed_revision",
        "original",
        "task"
      ],
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "comment_id": {
          "type": "string"
        },
        "segment": {
          "type": "object",
          "required": [
            "index"
          ],
          "additionalProperties": false,
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "label": {
              "type": "string"
            }
          }
        },
        "parent_item": {
          "type": "string"
        },
        "role": {
          "enum": [
            "review_comment",
            "review_segment",
            "reviewer_reply",
            "author_reply",
            "bot_comment"
          ]
        },
        "author_role": {
          "enum": [
            "reviewer",
            "author",
            "bot"
          ]
        },
        "posted_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewed_revision": {
          "type": "string",
          "minLength": 4
        },
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "line": {
              "type": "integer"
            }
          }
        },
        "original": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
        },
        "task": {
          "enum": [
            "rewrite",
            "context"
          ]
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "tier",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
        },
        "tier": {
          "enum": [
            "generator_input",
            "review_time",
            "evaluator_only",
            "outcome"
          ]
        },
        "kind": {
          "type": "string"
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        },
        "item_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string"
            },
            "retrieved_at": {
              "type": "string",
              "format": "date-time"
            },
            "method": {
              "type": "string"
            }
          }
        },
        "selection": {
          "type": "object",
          "required": [
            "basis",
            "method"
          ],
          "additionalProperties": false,
          "properties": {
            "basis": {
              "enum": [
                "primary",
                "secondary"
              ],
              "description": "primary: selected from original comments, diffs and code dependencies; secondary: selected from candidate rewrites or previous evaluations"
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string"
            },
            "revision": {
              "type": "string",
              "minLength": 4
            },
            "source_path": {
              "type": "string"
            },
            "git_blob": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "referenced_by": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "same_content_at": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "revision": {
          "type": "string",
          "minLength": 4
        },
        "availability_basis": {
          "enum": [
            "verified",
            "reconstructed",
            "unknown"
          ],
          "description": "verified: availability at that time is attested by the source system; reconstructed: inferred, e.g. from commit timestamps; unknown"
        },
        "availability_note": {
          "type": "string"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "required": [
        "snapshot_id",
        "repository",
        "revision",
        "available_at"
      ],
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "repository": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "minLength": 4
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        },
        "item_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        },
        "availability_basis": {
          "enum": [
            "verified",
            "reconstructed",
            "unknown"
          ],
          "description": "verified: availability at that time is attested by the source system; reconstructed: inferred, e.g. from commit timestamps; unknown"
        }
      }
    },
    "retrieval": {
      "type": "object",
      "required": [
        "target",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string"
        },
        "status": {
          "enum": [
            "included",
            "pointer_only",
            "not_retrieved",
            "inaccessible",
            "not_located",
            "failed",
            "not_applicable",
            "omitted_size",
            "unresolved",
            "ambiguous"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "selection_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_id",
        "blob",
        "kind",
        "repository",
        "revision",
        "source_path",
        "basis",
        "method",
        "referenced_by",
        "relevant_items",
        "available_at",
        "availability_basis"
      ],
      "properties": {
        "selection_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "blob": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the content stored at evidence/blobs/<sha256>"
        },
        "kind": {
          "enum": [
            "file_snapshot",
            "tree_listing"
          ]
        },
        "repository": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "minLength": 4
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "git_object": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "basis": {
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "referenced_by": {
          "type": "string",
          "minLength": 1,
          "description": "item id, candidate:<item> or prior:<document>"
        },
        "relevant_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        },
        "availability_basis": {
          "enum": [
            "verified",
            "reconstructed",
            "unknown"
          ],
          "description": "verified: availability at that time is attested by the source system; reconstructed: inferred, e.g. from commit timestamps; unknown"
        },
        "availability_note": {
          "type": "string"
        }
      }
    }
  }
}
